{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Native Control Layer",
  "version": "0.1.0",
  "identifier": "com.skartechtzone.linux-assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Native Control Layer",
        "width": 860,
        "height": 620,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "linux": {
      "deb": {
        "files": {
          "../packaging/ai-native-control-layer.service": "usr/share/doc/ai-native-control-layer/ai-native-control-layer.service"
        }
      }
    }
  }
}
